// KEYSTONE_CONFIG_v1 - the one place KS-Dialer's identity is set.
//
// project.yml lists this file under configFiles (Debug and Release), so every target reads these settings:
// bundle ids, the App Group in each entitlements file and Info.plist, display names, the KS-Ops URL and the team.
// The values below are placeholders. Replace them once the company's Apple Developer account exists (see README,
// "Keystone setup"), then run `xcodegen generate`. Nothing else in the repo needs to change.
//
// Note: "//" starts a comment in an .xcconfig, so URLs are written https:/$()/host ($() expands to nothing).

// iPhone app bundle id. The extensions and the Watch app are derived from it:
//   $(KS_APP_BUNDLE_ID).watchkitapp, .watchkitapp.widget, .liveactivity, .calldirectory, .notificationservice
KS_APP_BUNDLE_ID = com.keystone.dialer

// App Group shared by the app, widgets, Live Activity, Call Directory and the Watch app (register it in the
// Apple Developer portal and add it to every App ID above).
KS_APP_GROUP = group.com.keystone.dialer

// Home-screen name of the iPhone app (also used in the permission prompts), and the short name used for the
// Watch app, the widgets and the notification extension.
KS_APP_DISPLAY_NAME = Keystone Dialer
KS_SHORT_NAME = Dialer

// KS-Ops: resolves a company code to the company's own KS-server (GET {KS_OPS_URL}/api/directory/{code}).
KS_OPS_URL = https:/$()/ops.keystone.example

// Apple Developer team id (10 characters, Membership details in the Apple Developer portal). Empty builds unsigned
// for the simulator (CI). The "Upload iOS build" workflow reads this line.
DEVELOPMENT_TEAM =
